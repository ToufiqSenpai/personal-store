{
  "name": "personal-store",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "devsafe": "rm -rf dist && cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "bun server/index.ts",
    "studio": "mastra studio --port 4111 --server-host localhost --server-port 3000 --server-api-prefix /api/mastra",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@mastra/core": "^1.85.0",
    "@payloadcms/db-postgres": "4.0.0-beta.10",
    "@payloadcms/graphql": "4.0.0-beta.10",
    "@payloadcms/plugin-mcp": "4.0.0-beta.10",
    "@payloadcms/richtext-lexical": "4.0.0-beta.10",
    "@payloadcms/tanstack-start": "4.0.0-beta.10",
    "@payloadcms/ui": "4.0.0-beta.10",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "elysia": "2.0.0-rc.5",
    "exact-mirror": "^1.2.8",
    "graphql": "^16.8.1",
    "mastra": "^1.40.1",
    "openapi-types": "^12.1.3",
    "payload": "4.0.0-beta.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "^1.4.7",
    "vite": "8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.4.5",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.38",
    "jsdom": "28.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "sharp",
    "workerd",
    "bufferutil"
  ]
}
